# Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/adlync?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# Server Port
PORT=8080

# JWT Security
JWT_SECRET=your_jwt_secret_key_here_minimum_64_characters_long

# Initial Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123

# Email (SMTP) Configuration (Optional)
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password
